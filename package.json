{
	"name": "trasm",
	"version": "0.0.1",
	"private": true,
	"description": "thrift to json schema with typescript",
	"scripts": {
		"commit": "git czg",
		"prepare": "husky",
		"build": "nx run-many -t build --parallel=4",
		"esm": "pnpm build",
		"watch:esm": "nx watch --all --initialRun --verbose -- nx run-many -t build --parallel=4",
		"typecheck": "nx run-many -t typecheck --parallel=4 && tsc -p tsconfig.test.json",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:packages": "node --test scripts/verify-packages.mjs",
		"test:e2e": "pnpm --filter @trasm/e2e exec playwright test",
		"test:release": "node --test scripts/verify-release.mjs",
		"verify": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm test:packages && pnpm test:e2e && pnpm test:release",
		"web:dev": "pnpm --filter @trasm/parser-view dev",
		"clean": "node scripts/clean.mjs",
		"changeset_version": "pnpm exec changeset_version",
		"changeset_publish": "pnpm exec changeset_publish",
		"changeset": "changeset",
		"changeset:version": "changeset version",
		"changeset:publish": "changeset publish",
		"changeset:status": "changeset status --verbose",
		"build:app": "nx run @trasm/parser-view:build",
		"batch-rollup": "nx run @trasm/thrift-jsma:build"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cjinhuo/thrift-to-json-schema.git"
	},
	"engines": {
		"node": "^24.15.0",
		"pnpm": ">=12"
	},
	"author": "cjinhuo",
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@changesets/cli": "catalog:",
		"@commitlint/cli": "catalog:",
		"@commitlint/config-conventional": "catalog:",
		"@types/node": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"czg": "catalog:",
		"fast-glob": "catalog:",
		"husky": "catalog:",
		"lint-staged": "catalog:",
		"nx": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"changesets-toolkit": "catalog:"
	},
	"type": "module",
	"packageManager": "pnpm@12.21.0",
	"workspaces": [
		"packages/*",
		"utils/*",
		"app/*",
		"e2e"
	]
}
